{
  "opencollection": "1.0.0",
  "info": {
    "name": "SmartCustomer (Sitejabber) Business API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "client_token",
      "value": "{{client_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Log in and obtain a user token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.smartcustomer.com/v1/login",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "email",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "key": "client_token",
              "value": "{{client_token}}",
              "placement": "query"
            }
          },
          "docs": "Exchanges account credentials for a user token used in subsequent calls in the user_token header. The token typically expires after 6 months. Calling login invalidates any previously generated user token."
        }
      ]
    },
    {
      "info": {
        "name": "Business Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get info for a given business",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smartcustomer.com/v1/businesses/:business",
            "params": [
              {
                "name": "business",
                "value": "yourdomain.com",
                "type": "path",
                "description": "The business's display address (domain without scheme), e.g. yourdomain.com"
              },
              {
                "name": "datasources",
                "value": "",
                "type": "query",
                "description": "include ratings from specified comma separated data sources (check the data sources section)"
              }
            ]
          },
          "docs": "Get info for a given business"
        },
        {
          "info": {
            "name": "Get info for several businesses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smartcustomer.com/v1/businesses/bulk",
            "params": [
              {
                "name": "businesses",
                "value": "",
                "type": "query",
                "description": "all businesses to be queried encoded and json format"
              }
            ]
          },
          "docs": "Get info for several businesses"
        }
      ]
    },
